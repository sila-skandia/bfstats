# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY . .
RUN dotnet restore "api/api.csproj"
WORKDIR "/src/api"
# The ImageSharp licence: a BuildKit secret, as in deploy/Dockerfile.
RUN --mount=type=secret,id=sixlabors_lic,required=false \
    dotnet build "api.csproj" -c $BUILD_CONFIGURATION -o /app/build -p:SixLaborsLicenseFile=/run/secrets/sixlabors_lic

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN --mount=type=secret,id=sixlabors_lic,required=false \
    dotnet publish "api.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false -p:SixLaborsLicenseFile=/run/secrets/sixlabors_lic

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "api.dll"]
