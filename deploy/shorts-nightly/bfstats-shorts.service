[Unit]
Description=bfstats Replay Shorts: film and upload the newest recordings' best kills
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/skandia/projects/skandia/bfstats
Environment=PATH=/home/skandia/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/home/skandia/projects/skandia/bfstats/scripts/shorts-nightly.sh
Nice=10
TimeoutStartSec=3h

[Install]
WantedBy=default.target
