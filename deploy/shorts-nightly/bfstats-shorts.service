[Unit]
Description=bfstats Replay Shorts: film and upload the newest recordings' best kills
After=network-online.target

# A template: install.sh beside it fills in the path of the nightly's own
# checkout, brought up to origin/main each night. See README.md in this folder.
[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash __CHECKOUT__/deploy/shorts-nightly/run.sh
Nice=10
TimeoutStartSec=3h

[Install]
WantedBy=default.target
