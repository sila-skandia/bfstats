[Unit]
Description=bfstats Replay Shorts: film and upload the newest recordings' best kills
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/skandia/bfstats
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/projects/skandia/bfstats/scripts/shorts-nightly.sh
Nice=10
TimeoutStartSec=3h

[Install]
WantedBy=default.target
