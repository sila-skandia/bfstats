<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replay Shorts nightly on macOS: the launchd twin of bfstats-shorts.timer.
     A template: install.sh beside it fills in the paths (the nightly's own
     checkout, brought up to origin/main each night, and the home folder) and
     loads it.
     See README.md in this folder. A Mac asleep at 03:30 runs it once on waking.
     Run it now: launchctl kickstart gui/$(id -u)/io.bfstats.shorts -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.bfstats.shorts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CHECKOUT__/deploy/shorts-nightly/run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.cache/bfstats-shorts/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.cache/bfstats-shorts/launchd.log</string>
</dict>
</plist>
