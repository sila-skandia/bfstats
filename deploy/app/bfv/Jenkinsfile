pipeline {
  agent none
  options {
    disableConcurrentBuilds()
    skipDefaultCheckout()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 45, unit: 'MINUTES')
  }
  triggers {
    githubPush()
    pollSCM('H/5 * * * *')
  }
  environment {
    BFV_REPO   = 'https://github.com/luccawulf/bfstats-bfv.git'
    BFV_BRANCH = 'bfv'
    IMAGE      = 'anskia/bfv-site'
    SITE_URL   = 'https://bfv.bfstats.io'
  }
  stages {
    stage('Checkout') {
      agent { kubernetes { cloud 'Local k8s'; yamlFile 'deploy/pod.yaml'; nodeSelector 'kubernetes.io/hostname=bethany' } }
      steps {
        git url: env.BFV_REPO, branch: env.BFV_BRANCH, credentialsId: 'bfv-github-checks'
        script {
          env.GIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          publishChecks name: 'bfv-deploy', title: 'Build and deploy', status: 'IN_PROGRESS',
            summary: "Building ${env.GIT_SHA.take(8)} for ${env.SITE_URL}"
        }
        stash name: 'src', includes: 'mesh/**,tools/bf1942-models/viewer/**,tools/bf1942-models/upload/upload_service.py'
      }
    }
    stage('Build image') {
      agent { kubernetes { cloud 'Local k8s'; yamlFile 'deploy/pod.yaml'; nodeSelector 'kubernetes.io/hostname=bethany' } }
      steps {
        unstash 'src'
        container('dind') {
          withCredentials([usernamePassword(credentialsId: 'bfv-dockerhub', usernameVariable: 'DU', passwordVariable: 'DP')]) {
            sh '''
              set -eu
              echo "$DP" | docker login -u "$DU" --password-stdin
              docker buildx create --name bfv-builder --driver docker-container --use || docker buildx use bfv-builder
              docker buildx build -f mesh/Dockerfile . --platform linux/arm64 \
                --cache-from type=registry,ref=$IMAGE:buildcache \
                --cache-to type=registry,ref=$IMAGE:buildcache,mode=max \
                -t $IMAGE:latest -t $IMAGE:$GIT_SHA --push
            '''
          }
        }
      }
    }
    stage('Deploy') {
      agent { kubernetes { cloud 'Local k8s'; yamlFile 'deploy/pod.yaml'; nodeSelector 'kubernetes.io/hostname=bethany' } }
      steps {
        unstash 'src'
        container('kubectl') {
          withCredentials([file(credentialsId: 'bfv-k3s-kubeconfig', variable: 'KUBECONFIG')]) {
            sh '''
              set -eu
              kubectl -n bfv create configmap bfv-upload-code \
                --from-file=upload_service.py=tools/bf1942-models/upload/upload_service.py \
                --dry-run=client -o yaml | kubectl -n bfv apply -f -
              kubectl -n bfv set image deployment/bfv-site nginx=$IMAGE:$GIT_SHA
              kubectl -n bfv rollout status deployment/bfv-site --timeout=180s
            '''
          }
        }
      }
    }
  }
  post {
    success {
      publishChecks name: 'bfv-deploy', title: 'Deployed', conclusion: 'SUCCESS',
        summary: "${env.GIT_SHA?.take(8)} is live on ${env.SITE_URL}"
    }
    failure {
      script {
        def tail = currentBuild.rawBuild.getLog(120).join('\n')
        publishChecks name: 'bfv-deploy', title: 'Build or deploy failed', conclusion: 'FAILURE',
          summary: "Failed at stage ${env.STAGE_NAME ?: 'unknown'}. Last 120 log lines below.",
          text: "```\n${tail.take(60000)}\n```"
      }
    }
    aborted {
      publishChecks name: 'bfv-deploy', title: 'Cancelled', conclusion: 'CANCELED', summary: 'Build was cancelled or timed out'
    }
  }
}
