+/* PROBE xu: live Projectile objects (vptr 0x0873f2c8) in the registered map */
+static char g_pp[16384]; static int g_pp_len, g_pp_n, g_pp_pool;
+static void probe_proj_add(uint32_t node, uint32_t obj, uint32_t nid, uint32_t flags)
+{
+    if (flags & FLAG_DISABLED) { g_pp_pool++; return; }
+    if (g_pp_len > (int)sizeof(g_pp) - 256) return;
+    Mat4 m;
+    if (!T->safe_read(&m, sizeof(m), obj + T->obj_mat_off)) return;
+    char nm[96] = "";
+    tmpl_name_json(read_u32(obj + T->obj_tmpl_off), nm, sizeof(nm));
+    g_pp_len += snprintf(g_pp + g_pp_len, sizeof(g_pp) - g_pp_len, "%s[%u,\"%s\",%u,%u,%.2f,%.2f,%.2f]",
+        g_pp_n ? "," : "", read_u32(node + T->node_key_off), nm, nid, (flags & FLAG_ROOT) ? 1u : 0u,
+        m.p[0], m.p[1], m.p[2]);
+    g_pp_n++;
+}
+static void probe_proj_flush(double t)
+{
+    char line[16640];
+    snprintf(line, sizeof(line), "{\"k\":\"xu\",\"t\":%.3f,\"pool\":%d,\"o\":[%s]}", t, g_pp_pool, g_pp);
+    if (g_pp_n || g_pp_pool) write_line(line);
+    g_pp_len = 0; g_pp_n = 0; g_pp_pool = 0; g_pp[0] = 0;
+}
