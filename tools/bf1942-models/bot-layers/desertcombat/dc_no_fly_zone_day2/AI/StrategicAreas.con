rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create Opposition_Airbase 2701.7/1154.2 2706.7/1159.2 50
aiStrategicArea.addNeighbour Coalition_Airbase
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 2706.5/1157.5
aiStrategicArea.setOrderPosition Infantry 2707.5/1158.5
aiStrategicArea.setSide 1
aiStrategicArea.setTakeable 2 0

