aiStrategicArea.addObjectTypeFlag StrongPoint
aiStrategicArea.addObjectTypeFlag ControlPoint
aiStrategicArea.setOrderPosition Tank 906.5/668.5
aiStrategicArea.setOrderPosition Infantry 902.5/658.5
aiStrategicArea.setSide 1

aiStrategicArea.create frontline 869.1/538.7 874.1/543.7 200
