rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create northern_village 849.8/828.8 869.8/848.8 200
aiStrategicArea.addNeighbour inner_trench
aiStrategicArea.addObjectTypeFlag Centre
aiStrategicArea.addObjectTypeFlag ControlPoint
aiStrategicArea.setOrderPosition Tank 869.5/850.5
aiStrategicArea.setOrderPosition Infantry 870.5/848.5
aiStrategicArea.setSide 1

aiStrategicArea.create inner_trench 897.8/654.2 902.8/659.2 300
