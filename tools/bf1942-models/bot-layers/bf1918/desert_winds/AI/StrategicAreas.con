rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create oasis 816.2/734.9 856.2/774.9 10
aiStrategicArea.setTakeable 1 0
aiStrategicArea.setTakeable 2 0

aiStrategicArea.create alliedbase 123.4/185 128.4/190 50
aiStrategicArea.addNeighbour axisbase
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Infantry 127.5/191.5
aiStrategicArea.setSide 2
aiStrategicArea.setTakeable 1 0

aiStrategicArea.create caravan 926/1288 966/1328 10
aiStrategicArea.setTakeable 1 0
aiStrategicArea.setTakeable 2 0

aiStrategicArea.create axisbase 106.4/1858.7 111.4/1863.7 50
aiStrategicArea.addNeighbour alliedbase
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Infantry 112.5/1864.5
aiStrategicArea.setSide 1
aiStrategicArea.setTakeable 2 0
