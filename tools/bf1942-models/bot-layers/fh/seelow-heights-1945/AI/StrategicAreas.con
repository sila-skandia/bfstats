rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create axisbase 630.7/974.7 635.7/979.7 10
aiStrategicArea.setSide 1
aiStrategicArea.setTakeable 1 0
aiStrategicArea.setTakeable 2 0

aiStrategicArea.create alliedbase 1834.1/1318.5 1839.1/1323.5 50
aiStrategicArea.addNeighbour hill_foottemplate
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 1839.5/1325.5
aiStrategicArea.setOrderPosition Infantry 1840.5/1324.5
aiStrategicArea.setSide 2
aiStrategicArea.setTakeable 1 0

aiStrategicArea.create hill_foottemplate 1235.1/1067.9 1260.1/1092.9 300
