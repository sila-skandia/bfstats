aiStrategicArea.addNeighbour stationtemplate
aiStrategicArea.addNeighbour seelow_mil_hqtemplate
aiStrategicArea.addNeighbour seelow_outskirtstemplate
aiStrategicArea.addObjectTypeFlag Centre
aiStrategicArea.addObjectTypeFlag StrongPoint
aiStrategicArea.addObjectTypeFlag Close
aiStrategicArea.addObjectTypeFlag ControlPoint
aiStrategicArea.setOrderPosition Tank 1262.5/1092.5
aiStrategicArea.setOrderPosition Infantry 1261.5/1091.5
aiStrategicArea.setSide 1

