rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create AxisBase 383.5/406.7 398.5/421.7 50
aiStrategicArea.addNeighbour New_Control_Point1
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 398.5/422.5
aiStrategicArea.setOrderPosition Infantry 398.5/421.7
aiStrategicArea.setSide 1
aiStrategicArea.setTakeable 2 0

aiStrategicArea.create AlliedBase 635.9/647.1 650.9/662.1 50
aiStrategicArea.addNeighbour New_Control_Point1
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 650.9/662.1
aiStrategicArea.setOrderPosition Infantry 650.9/662.1
aiStrategicArea.setSide 2
aiStrategicArea.setTakeable 1 0

aiStrategicArea.create New_Control_Point1 611/339.2 616/344.2 150
aiStrategicArea.addNeighbour AxisBase
aiStrategicArea.addNeighbour AlliedBase
aiStrategicArea.addObjectTypeFlag Flank
aiStrategicArea.addObjectTypeFlag Close
aiStrategicArea.addObjectTypeFlag ControlPoint
aiStrategicArea.setOrderPosition Tank 616/344.2
aiStrategicArea.setOrderPosition Infantry 616/344.2
