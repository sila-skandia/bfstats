rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create AxisBase 507/447 512/452 50
aiStrategicArea.addNeighbour AlliedBase
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 511.5/454.5
aiStrategicArea.setOrderPosition Infantry 511.5/453.5
aiStrategicArea.setSide 1
aiStrategicArea.setTakeable 2 0

aiStrategicArea.create AlliedBase 507/567 512/572 50
aiStrategicArea.addNeighbour AxisBase
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 514.5/572.5
aiStrategicArea.setOrderPosition Infantry 511.5/573.5
aiStrategicArea.setSide 2
aiStrategicArea.setTakeable 1 0

aiStrategicArea.create New_Control_Point1 260.4/674.3 265.4/679.3 10
aiStrategicArea.setSide 1
aiStrategicArea.setTakeable 1 0
aiStrategicArea.setTakeable 2 0
