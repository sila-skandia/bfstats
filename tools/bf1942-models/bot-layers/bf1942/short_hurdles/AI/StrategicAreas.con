rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create AxisBase 513/467.8 518/472.8 50
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 508.5/473.5
aiStrategicArea.setOrderPosition Infantry 517.5/471.5
aiStrategicArea.setSide 1
aiStrategicArea.setTakeable 2 0

aiStrategicArea.create AlliedBase 512.9/540.3 517.9/545.3 50
aiStrategicArea.addObjectTypeFlag Base
aiStrategicArea.setOrderPosition Tank 508.5/547.5
aiStrategicArea.setSide 2
aiStrategicArea.setTakeable 1 0

aiStrategicArea.create Midflag 512.8/502.8 517.8/507.8 10
aiStrategicArea.setTakeable 1 0
aiStrategicArea.setTakeable 2 0
