rem *** Strategic areas: one per control point (botgen) ***

aiStrategicArea.create southopenbase 879.6/532.7 907.6/560.7 150
aiStrategicArea.addNeighbour eastopenbase
aiStrategicArea.addNeighbour alliesbase
aiStrategicArea.addNeighbour axisbase
aiStrategicArea.addObjectTypeFlag Flank
aiStrategicArea.addObjectTypeFlag Close
aiStrategicArea.addObjectTypeFlag ControlPoint
aiStrategicArea.setOrderPosition Tank 907.5/563.5
aiStrategicArea.setOrderPosition Infantry 907.6/560.7

