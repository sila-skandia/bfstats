{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "ui"
      ],
      "port": 5173
    },
    {
      "name": "model-viewer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server \"$PORT\" --directory tools/bf1942-models/viewer"
      ],
      "autoPort": true,
      "port": 5273
    },
    {
      "name": "physics-viewer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server \"$PORT\" --directory .claude/worktrees/refractor-physics/tools/bf1942-models/viewer"
      ],
      "autoPort": true,
      "port": 5373
    },
    {
      "name": "play-netcode",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/bf1942-models/server/dev.mjs",
        "--static-port",
        "8100",
        "--netcode-port",
        "8180"
      ],
      "autoPort": false,
      "port": 8100
    },
    {
      "name": "radio-chat-viewer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server \"$PORT\" --directory ../bfstats-radio-chat/tools/bf1942-models/viewer"
      ],
      "autoPort": true,
      "port": 5485
    }
  ]
}
