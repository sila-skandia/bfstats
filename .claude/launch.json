{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd api && dotnet run"
      ],
      "port": 9222
    },
    {
      "name": "api-replay-feed",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd api && ASPNETCORE_ENVIRONMENT=Development E2E_SEED=true DB_PATH=/tmp/feed.db Jwt__PrivateKey=\"$(base64 < ../.e2e/jwt-e2e.pem | tr -d '\\n')\" RefreshToken__Secret=\"$(cat ../.e2e/refresh-secret)\" Jwt__Issuer=http://localhost:9222 Jwt__Audience=http://localhost:5273 Recordings__Path=/tmp/feed-recordings Recordings__MinFreeBytes=0 Recordings__MinFreeFraction=0 dotnet run --no-launch-profile --urls http://localhost:9222"
      ],
      "port": 9222
    },
    {
      "name": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "ui"
      ],
      "port": 5173
    },
    {
      "name": "model-viewer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 tools/bf1942-models/serve_viewer.py \"$PORT\""
      ],
      "autoPort": true,
      "port": 5273
    },
    {
      "name": "physics-viewer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server \"$PORT\" --directory .claude/worktrees/refractor-physics/tools/bf1942-models/viewer"
      ],
      "autoPort": true,
      "port": 5373
    },
    {
      "name": "play-netcode",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/bf1942-models/server/dev.mjs",
        "--static-port",
        "8100",
        "--netcode-port",
        "8180"
      ],
      "autoPort": false,
      "port": 8100
    },
    {
      "name": "radio-chat-viewer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server \"$PORT\" --directory ../bfstats-radio-chat/tools/bf1942-models/viewer"
      ],
      "autoPort": true,
      "port": 5485
    }
  ]
}
